module claimScenarios {
  import claimProtocol.* from "../../contracts/claim"
  export claimProtocol.*
  pure val r2: ClaimRequest = { ...r1, worker: 2 }
  pure val a2: ClaimReply = { request: r2, token: { ...a1.token, worker: 2 } }
  run executionBeforeDispatchSurvivesCoordinatorRestartTest = claimPreparedInit
    .then(all { crashCoordinator, holdClaims }).then(all { restartCoordinator, holdClaims })
    .expect(claimSafety and claimJournal.size() == 0 and authority.durable.attempts.get(1).exists)
    .then(sendClaim(r1)).then(commitClaim(r1)).then(receiveClaim(a1)).expect(claimSafety and deliveredWitness)
  run commitBeforeDeliveryTest = claimCommittedInit.expect(claimSafety)
    .expect(claimJournal == Set(a1) and workers.get(1).leases.size() == 0)
  run lostReplyReplaysOriginalAllocationTest = claimLostInit.then(sendClaim(r1)).then(commitClaim(r1))
    .then(receiveClaim(a1)).expect(claimSafety and replayWitness and deliveredWitness)
    .expect(claimJournal == Set(a1) and authority.durable.history.length() == 2)
  run receivedClaimIsNotStartPermissionTest = claimCommittedInit.then(receiveClaim(a1))
    .expect(claimSafety).then(all { callExternal(a1.token), holdClaims }.fail())
  run replayAfterCoordinatorRestartTest = claimLostInit.then(all { crashCoordinator, holdClaims })
    .then(all { restartCoordinator, holdClaims }).then(sendClaim(r1)).then(commitClaim(r1))
    .then(receiveClaim(a1)).expect(claimSafety and claimJournal == Set(a1))
  run competingClaimsFirstWinsTest = claimPreparedInit.then(sendClaim(r1)).then(sendClaim(r2))
    .then(commitClaim(r1)).then(commitClaim(r2)).expect(claimSafety)
    .expect(claimJournal == Set(a1) and not(claimWire.replies.contains(a2)))
  run competingClaimsReverseWinsTest = claimPreparedInit.then(sendClaim(r1)).then(sendClaim(r2))
    .then(commitClaim(r2)).then(commitClaim(r1)).expect(claimSafety and claimJournal == Set(a2))
  run expiredReplayDoesNotAllocateAgainTest = claimLostInit.then(all { moveClockTo(2), holdClaims })
    .then(all { expireLease(1), holdClaims }).then(sendClaim(r1)).then(commitClaim(r1))
    .expect(claimSafety and claimJournal == Set(a1) and claimWire.replies.size() == 0)
  run freshExpectedGenerationCanReclaimTest = claimCommittedInit.then(all { moveClockTo(2), holdClaims })
    .then(sendClaim({ ...r2, expected: 1 })).then(commitClaim({ ...r2, expected: 1 }))
    .expect(claimSafety and claimJournal.size() == 2)
    .expect(authority.durable.attempts.get(1).lease.generation == 2)
  run lateReplyDoesNotRestoreOldAuthorityTest = claimCommittedInit.then(all { moveClockTo(2), holdClaims })
    .then(sendClaim({ ...r2, expected: 1 })).then(commitClaim({ ...r2, expected: 1 }))
    .then(receiveClaim(a1)).then(all { requestStart(a1.token), holdClaims }).expect(claimSafety)
    .then(all { authorizeStart(a1.token), holdClaims }.fail())
  run oldIncarnationReplyDisabledTest = claimCommittedInit.then(all { crashWorker(1), holdClaims })
    .then(all { restartWorker(1), holdClaims }).expect(claimSafety).then(receiveClaim(a1).fail())
  run receivedClaimCanStartExactlyOnceTest = claimCommittedInit.then(receiveClaim(a1))
    .then(all { requestStart(a1.token), holdClaims }).then(all { authorizeStart(a1.token), holdClaims })
    .then(all { receiveGrant(a1.token), holdClaims }).then(all { callExternal(a1.token), holdClaims })
    .expect(claimSafety and calledWitness).then(all { callExternal(a1.token), holdClaims }.fail())
}
