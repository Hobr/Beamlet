module formal_test {
  import architectureTypes.* from "./types"
  import architecture(RUNS = Set(0, 1, 2), SLOTS = Set(0, 1), ATTEMPT_SLOTS = Set(0, 1, 2), QUEUE_LIMIT = 12, COMMAND_LIMIT = 32).* from "./architecture"
  pure val e = (1, 0)
  pure val a = (e, 0)
  pure val e1 = (1, 1)
  pure val a1 = (e1, 0)
  pure val creation = {...emptyCommand, tag: CreationCommand, runId: 1, progress: Ready, definition: 1}
  run startReadyReceiptTest = init.then(command(0, creation)).expect(architectureSafety and s.runs.get(1).inbox.length() == 1 and s.runs.get(1).cursor == 0)
    .then(setMode(1, Suspended)).expect(architectureSafety).then(command(0, creation)).expect(architectureSafety and s.runs.get(1).history == 2)
    .then(rejectCommand(0, {...creation, definition: 2})).expect(architectureSafety and s.error == KeyConflict)
  run deterministicFirstDefinitionTest = init.then(command(0, creation)).expect(architectureSafety)
    .then(evaluate(1, 0, InvokeStep, 0, NonRepeatable)).expect(architectureSafety).then(commitEnvelope(0)).expect(architectureSafety)
    .then(authorize(e, a, 0, 0, 0)).expect(architectureSafety).then(enter(a, 0)).expect(architectureSafety).then(complete(a, Success)).expect(architectureSafety).then(report(a, 0)).expect(architectureSafety)
    .then(evaluate(1, 0, ContinueStep, 0, NonRepeatable)).expect(architectureSafety).then(commitEnvelope(0)).expect(architectureSafety)
    .then(evaluate(1, 0, InvokeStep, 1, NonRepeatable)).expect(architectureSafety).then(commitEnvelope(0)).expect(architectureSafety)
    .then(authorize(e1, a1, 1, 0, 0)).expect(architectureSafety).then(enter(a1, 1)).expect(architectureSafety).then(complete(a1, Success)).expect(architectureSafety).then(report(a1, 1)).expect(architectureSafety)
    .then(evaluate(1, 0, FinishStep, 0, NonRepeatable)).expect(architectureSafety).then(commitEnvelope(0)).expect(architectureSafety)
    .expect(s.effects.get(e).operation == 0 and s.effects.get(e1).operation == 1 and s.runs.get(1).result == 4)
    .then(send({...emptyCommand, tag: ArchiveCommand, runId: 1, dst: 2, boundary: 4})).expect(architectureSafety)
    .expect(s.runs.get(2).definition == 1 and s.runs.get(2).result == 4 and s.runs.get(2).origin.results == Set((e, OkResult, 0), (e1, OkResult, 0)) and s.runs.get(2).origin.events.size() == 4 and s.runs.get(2).inbox.length() == 0 and s.runs.get(2).cursor == 0)
  run deterministicSecondDefinitionTest = init.then(send({...creation, definition: 2})).expect(architectureSafety)
    .then(evaluate(1, 0, InvokeStep, 0, NonRepeatable)).then(commitEnvelope(0)).expect(architectureSafety)
    .then(authorize(e, a, 0, 0, 0)).then(enter(a, 0)).then(complete(a, Success)).then(report(a, 0)).expect(architectureSafety)
    .then(evaluate(1, 0, InvokeStep, 1, NonRepeatable)).then(commitEnvelope(0)).expect(architectureSafety)
    .then(authorize(e1, a1, 1, 0, 0)).then(enter(a1, 1)).then(complete(a1, Success)).then(report(a1, 1)).expect(architectureSafety)
    .then(evaluate(1, 0, FinishStep, 0, NonRepeatable)).then(commitEnvelope(0)).expect(architectureSafety)
    .expect(s.effects.get(e).operation == 1 and s.effects.get(e1).operation == 0 and s.runs.get(1).result == 3)
  run deterministicDefinitionRefusalTest = init.then(command(0, creation)).expect(architectureSafety)
    .expect(not(canEvaluate(s, 1, WaitStep, 0)) and not(canEvaluate(s, 1, InvokeStep, 1)))
    .then(rejectCommand(1, {...emptyCommand, tag: BusinessCommand, runId: 1, stepKind: WaitStep})).expect(architectureSafety and s.error == StalePermission)
  run pending = init.then(send({...creation, definition: 0})).then(evaluate(1, 0, InvokeStep, 0, NonRepeatable)).then(commitEnvelope(0)).expect(architectureSafety)
  run scopeHierarchyAndIsolationTest = pending.then(providerFault(1, ProviderAbsent)).expect(architectureSafety and not(canAdmit(s, e, a, 0, 0, 0)))
    .then(scopeIsolation(1)).expect(architectureSafety and providerId(s, 1) == 0 and canAdmit(s, e, a, 0, 0, 0))
    .then(authorize(e, a, 0, 0, 0)).expect(architectureSafety and s.attempts.get(a).provider == 0)
    .then(providerFault(1, ProviderAbsent)).expect(architectureSafety and not(canEnter(s, a, 0)))
    .then(precheckReject(a)).then(report(a, 0)).expect(architectureSafety and s.effects.get(e).phase == Pending and s.attempts.get(a).calls == 0)
  run resourceIdentityAndPermissionTest = pending.then(providerResource(1, 1)).expect(architectureSafety and not(canAdmit(s, e, a, 0, 0, 0)) and s.effects.get(e).resource == 0)
    .then(providerResource(1, 0)).then(resourceAvailability(0)).expect(architectureSafety and not(canAdmit(s, e, a, 0, 0, 0)))
    .then(resourceAvailability(0)).then(resourcePermission(0)).expect(architectureSafety and not(canAdmit(s, e, a, 0, 0, 0)))
    .then(rejectRead(ResourceOp, 0, 0, 0)).expect(architectureSafety and s.error == Forbidden)
  run roleWriteAndExecutionEligibilityTest = pending.then(role(AuthorityRole)).expect(architectureSafety and not(canAdmit(s, e, a, 0, 0, 0)))
    .then(rejectCommand(2, admissionEnvelope(s, e, a, 0, 0, 0))).expect(architectureSafety and s.error == AuthorityUnavailable)
    .then(role(AuthorityRole)).then(authorize(e, a, 0, 0, 0)).expect(architectureSafety)
    .then(role(ComputeRole)).expect(architectureSafety and not(canEvaluate(s, 1, WaitStep, 0)))
    .then(enter(a, 0)).then(complete(a, Success)).then(report(a, 0)).expect(architectureSafety)
    .then(role(ExecuteRole)).expect(architectureSafety)
  run queryExportResourceAuthorizationTest = init.then(inspect(0)).expect(architectureSafety and s.queryReads == 1)
    .then(permission(InspectOp)).then(rejectRead(InspectOp, 0, 0, 0)).expect(architectureSafety and s.error == Forbidden and s.queryReads == 1)
    .then(exportBoundary(0, 0)).expect(architectureSafety and s.exports.size() == 1)
    .then(permission(ExportOp)).then(rejectRead(ExportOp, 0, 0, 0)).expect(architectureSafety and s.error == Forbidden and s.exports.size() == 1)
    .then(permission(ResourceOp)).then(rejectRead(ResourceOp, 0, 0, 0)).expect(architectureSafety and s.error == Forbidden)
    .then(authentication).then(rejectRead(ExportOp, 0, 0, 0)).expect(architectureSafety and s.error == Unauthenticated)
}
