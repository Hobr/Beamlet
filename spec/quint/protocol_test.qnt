module protocol_test {
  import architectureTypes.* from "./types"
  import architecture(RUNS = Set(0, 1), SLOTS = Set(0, 1), ATTEMPT_SLOTS = Set(0, 1, 2), QUEUE_LIMIT = 12, COMMAND_LIMIT = 32).* from "./architecture"
  pure val e = (0, 0)
  pure val a = (e, 0)
  pure val b = (e, 1)
  pure val admission = {...emptyCommand, tag: AdmissionCommand}
  pure val repeat = {...emptyCommand, tag: ResolutionCommand, decision: RepeatOp, revision: 2, source: 1, evidence: 2}
  pure val settlement = {...emptyCommand, tag: ResolutionCommand, decision: SettleOp, revision: 2, source: 1, evidence: 2, payload: 1}
  pure val suspended = {...emptyCommand, tag: ModeCommand}
  pure val observation = {...emptyCommand, tag: ObservationCommand, observation: Success, observationId: 4}
  pure val submission = {...emptyCommand, inputId: 3, payload: 1}
  run pending = init.then(appendInput(0, 0, 1)).then(evaluate(0, 0, InvokeStep, 0, NonRepeatable)).then(commit(0)).expect(architectureSafety)
  run unknownPrefix = pending.then(admit(e, a, 0, 0, 0)).then(enter(a, 0)).then(ownerFault(0, false)).then(lose(a)).expect(architectureSafety)
  run completedPrefix = pending.then(admit(e, a, 0, 0, 0)).then(enter(a, 0)).then(complete(a, Success)).expect(architectureSafety)
  run admissionReceiptFirstTest = pending.then(command(0, admission)).expect(architectureSafety)
    .then(command(1, suspended)).expect(architectureSafety).then(writeAvailability)
    .then(command(0, admission)).expect(architectureSafety and s.acknowledged and s.grants.size() == 1 and s.commandReceipts.get(0).executionRevision == 1)
    .then(rejectCommand(2, admission)).expect(s.error == AuthorityUnavailable)
    .then(writeAvailability).then(rejectCommand(2, admission)).expect(s.error == StalePermission and not(s.commandReceipts.get(2).valid))
  run originalBindingEnvelopeTest = pending.then(command(0, admission)).then(replaceProvider(0, false)).then(command(0, admission))
    .expect(architectureSafety and s.commandReceipts.get(0).body.generation == 0)
    .then(rejectCommand(0, {...admission, generation: 1})).expect(s.error == KeyConflict)
    .then(rejectCommand(1, {...admission, revision: 1})).expect(s.error == StalePermission)
  run resolutionReceiptAndPermitTest = unknownPrefix.then(command(0, repeat)).expect(architectureSafety)
    .then(command(1, {...admission, attempt: 1, owner: 1, revision: 3})).expect(architectureSafety)
    .then(command(0, repeat)).expect(architectureSafety and s.effects.get(e).permitsUsed == Set(1) and s.grants.size() == 2)
    .then(rejectCommand(0, {...repeat, revision: 4})).expect(s.error == KeyConflict)
    .then(rejectCommand(2, repeat)).expect(s.error == StalePermission)
  run boundedResolutionProvenanceTest = unknownPrefix.then(rejectCommand(0, {...repeat, source: 2})).expect(s.error == InvalidData and s.resolutions.size() == 0)
    .then(command(0, repeat)).expect(architectureSafety and s.resolutions.exists(f => f.source == 1 and f.evidence == 2 and f.revision == 2 and f.operation == RepeatOp))
  run inputIdIndependentTest = init.then(command(0, submission)).expect(architectureSafety)
    .then(command(1, submission)).expect(architectureSafety and s.runs.get(0).inbox.length() == 1 and s.runs.get(0).history == 2)
    .then(command(0, submission)).expect(s.runs.get(0).history == 2 and s.commandReceipts.get(0).history == 1)
    .then(rejectCommand(2, {...submission, payload: 0})).expect(s.error == KeyConflict and not(s.commandReceipts.get(2).valid))
    .then(rejectCommand(0, {...submission, inputId: 4})).expect(s.error == KeyConflict and s.runs.get(0).inbox.length() == 1)
  run observationIdIndependentTest = completedPrefix.then(command(0, observation)).expect(architectureSafety)
    .then(command(1, observation)).expect(architectureSafety and s.effects.get(e).replyCount == 1 and s.effects.get(e).revision == 2)
    .then(rejectCommand(2, {...observation, payload: 1})).expect(s.error == KeyConflict)
    .then(command(2, {...observation, observationId: 5, payload: 1})).expect(architectureSafety and s.effects.get(e).resultPayload == 0 and s.effects.get(e).replyCount == 1)
  run settlementPayloadRetentionTest = unknownPrefix.then(command(0, settlement)).expect(architectureSafety)
    .then(complete(a, Success)).then(command(1, observation)).expect(architectureSafety and s.effects.get(e).resultPayload == 1)
    .then(command(0, settlement)).expect(architectureSafety and s.commandReceipts.get(0).executionRevision == 3 and s.effects.get(e).replyCount == 1)
    .then(rejectCommand(2, settlement)).expect(s.error == StalePermission)
    .then(rejectCommand(2, {...settlement, revision: 4})).expect(s.error == AlreadyResolved)
  run controlAndHostReceiptsTest = init.then(command(0, suspended)).expect(architectureSafety)
    .then(command(1, {...emptyCommand, tag: HostCommand, epoch: 1})).expect(architectureSafety)
    .then(command(0, suspended)).expect(architectureSafety and s.runs.get(0).host == 2 and s.runs.get(0).history == 2)
    .then(rejectCommand(0, {...suspended, epoch: 2})).expect(s.error == KeyConflict)
    .then(command(2, {...emptyCommand, tag: ControllerCommand, epoch: 1})).expect(architectureSafety)
    .then(command(2, {...emptyCommand, tag: ControllerCommand, epoch: 1})).expect(s.runs.get(0).controller == 2 and s.runs.get(0).history == 3)
  run forkAndImportReceiptsTest = init.then(command(0, {...emptyCommand, tag: ArchiveCommand, dst: 1})).expect(architectureSafety)
    .then(control(1, Active)).then(appendInput(1, 0, 1)).then(command(0, {...emptyCommand, tag: ArchiveCommand, dst: 1}))
    .expect(architectureSafety and s.runs.get(1).inbox.length() == 1 and s.commandReceipts.get(0).body.dst == 1)
    .then(rejectCommand(0, {...emptyCommand, tag: BranchCommand, dst: 1})).expect(s.error == KeyConflict)
  run authorizationBeforeEveryReceiptTest = pending.then(command(0, admission)).then(permission(AdmitOp)).then(rejectCommand(0, admission))
    .expect(s.error == Forbidden and s.receiptReads == 0).then(permission(AdmitOp)).then(authentication).then(rejectCommand(0, admission))
    .expect(s.error == Unauthenticated and s.receiptReads == 0 and s.grants.size() == 1)
  run businessEnvelopeOriginalConditionsTest = init.then(command(0, submission)).then(evaluate(0, 0, InvokeStep, 0, NonRepeatable))
    .then(command(1, proposalCommand(s, 0, BusinessCommand))).expect(architectureSafety)
    .then(control(0, Suspended)).then(command(1, {...emptyCommand, tag: BusinessCommand, stepKind: InvokeStep}))
    .expect(architectureSafety and s.runs.get(0).app == 1 and s.effects.get(e).exists)
    .then(rejectCommand(1, {...emptyCommand, tag: BusinessCommand, stepKind: InvokeStep, revision: 1})).expect(s.error == KeyConflict)
  run commandHistoryAllMutationsTest = unknownPrefix.then(command(0, {...repeat, decision: AuditOp})).expect(architectureSafety and s.runs.get(0).history == 5)
    .then(command(1, {...repeat, revision: 3})).expect(architectureSafety and s.runs.get(0).history == 6)
    .then(command(1, {...repeat, revision: 3})).expect(architectureSafety and s.runs.get(0).history == 6)
  run unknownObservationIdsTest = pending.then(admit(e, a, 0, 0, 0)).then(ownerFault(0, false))
    .then(command(0, {...emptyCommand, tag: LossCommand, observation: Lost})).expect(architectureSafety)
    .then(command(1, {...emptyCommand, tag: LossCommand, observation: Lost})).expect(architectureSafety and s.effects.get(e).notifications == 1 and s.effects.get(e).revision == 2)
    .then(rejectCommand(2, {...emptyCommand, tag: LossCommand, observation: Lost, payload: 1})).expect(s.error == KeyConflict)
}
