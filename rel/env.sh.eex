#!/bin/sh
# Long names and cookie are operator-managed. Never echo RELEASE_COOKIE.
export RELEASE_DISTRIBUTION=name
: "${RELEASE_NODE:?set a long node name such as authority@host.example}"
: "${RELEASE_COOKIE:?provide the shared trusted-cluster cookie securely}"
: "${BEAMLET_CONFIG:?set an absolute trusted config path}"
# Control commands start a separate hidden VM on the service host. They must
# not contend for the service's fixed distribution listener.
case "${RELEASE_COMMAND:-}" in
  rpc|remote|restart|stop|pid) beamlet_dist_port=0 ;;
  *) beamlet_dist_port=${BEAMLET_DIST_PORT:-9100} ;;
esac
export ELIXIR_ERL_OPTIONS="+S 2:2 -kernel inet_dist_listen_min ${beamlet_dist_port} inet_dist_listen_max ${beamlet_dist_port} ${ELIXIR_ERL_OPTIONS:-}"
