<Layouts.app flash={@flash}>
  <section class="max-w-3xl">
    <.badge color="primary" label="Beamlet Web" />
    <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">
      A workspace for durable agents.
    </h1>
    <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
      Beamlet brings persistent execution and agent workflows together.
      The web workspace is under development.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <.button navigate={~p"/components"} variant="primary">
        Explore components
      </.button>
      <.button href="https://hexdocs.pm/phoenix/overview.html" color="gray" variant="outline">
        Phoenix documentation
      </.button>
    </div>
  </section>

  <section aria-label="Resources" class="mt-16 grid gap-6 md:grid-cols-3">
    <.card>
      <.card_content heading="Build with Petal">
        <p class="text-gray-600 dark:text-gray-400">
          Forms, tables, dialogs, and navigation for interactive pages.
        </p>
      </.card_content>
      <.card_footer>
        <.button href="https://petal.build/components" color="gray" variant="ghost">
          Component documentation
        </.button>
      </.card_footer>
    </.card>
    <.card>
      <.card_content heading="Phoenix Framework">
        <p class="text-gray-600 dark:text-gray-400">
          Peace of mind from prototype to production.
        </p>
      </.card_content>
      <.card_footer>
        <.button href="https://phoenixframework.org/" color="gray" variant="ghost">
          Phoenix website
        </.button>
      </.card_footer>
    </.card>
    <.card>
      <.card_content heading="Keep up to date">
        <p class="text-gray-600 dark:text-gray-400">
          Follow the source and release notes for Phoenix {Application.spec(:phoenix, :vsn)}.
        </p>
      </.card_content>
      <.card_footer>
        <.button
          href={"https://github.com/phoenixframework/phoenix/blob/v#{Application.spec(:phoenix, :vsn)}/CHANGELOG.md"}
          color="gray"
          variant="ghost"
        >
          Changelog
        </.button>
      </.card_footer>
    </.card>
  </section>

  <footer class="mt-12 flex flex-wrap gap-x-6 gap-y-3 text-sm text-gray-600 dark:text-gray-400">
    <.link href="https://elixirforum.com" class="hover:underline">Elixir Forum</.link>
    <.link href="https://discord.gg/elixir" class="hover:underline">Discord</.link>
    <.link href="https://elixir-slack.community/" class="hover:underline">Slack</.link>
    <.link href="https://fly.io/docs/elixir/getting-started/" class="hover:underline">
      Deployment guide
    </.link>
  </footer>
</Layouts.app>
